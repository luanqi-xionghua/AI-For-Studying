{
  "name": "phydog-desktop",
  "version": "1.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-assets.mjs && vue-tsc --noEmit && vite build",
    "desktop:dev": "node scripts/python-desktop.mjs",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-windows.ps1",
    "test": "node --test tests/unit/*.test.mjs",
    "test:python": "node scripts/python-desktop.mjs --test"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "highlight.js": "^11.11.1",
    "katex": "0.19.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "6.4.299",
    "perfect-freehand": "1.2.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
